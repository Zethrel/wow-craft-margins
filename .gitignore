# Credentials. config.json holds your Battle.net client_id and client_secret;
# committing it once puts them in history for good. config.example.json is the
# tracked template - copy it to config.json and fill it in.
config.json

# The price history database. Deliberately untracked: it is 23 MB and rewrites
# itself every scan, so committing it would add that much to the repo every
# hour. It is also the one thing here that cannot be regenerated - past auction
# snapshots are gone once Blizzard moves on - so back it up separately if the
# history matters to you.
wowcraft.sqlite3
*.sqlite3-journal
*.sqlite3-wal
# Hand-made backups, e.g. before a `pull` replaces the database.
*.sqlite3.bak-*

# Generated every scan.
dashboard.html
scan.log
scan.log.tmp
doctor-report.txt

# Written into the addon folder by scan, never edited by hand.
addon/WowCraftExport/PriceData.lua

# PyInstaller output. The exe is a build artefact - 12 MB that changes with
# every code change, rebuildable in twenty seconds with build-exe.cmd.
build/
dist/
*.spec
pricecheck.exe

# What `scan --publish` builds for GitHub Pages. Regenerated every run and
# uploaded straight from the runner, so it never needs to be in the repo.
# seed/ is the exception and IS tracked - see the README.
site/

# Which published files this PC already has, so `pull` can skip them.
.pull-state.json

__pycache__/
*.pyc

# Other people's data. The TSM SavedVariables a supporter shared is one
# person's actual account: 23 character names, a gold log, and three and a
# half years of transactions. It is here to read for ideas, not to publish -
# and this repo is public.
TSM information and inspiration/

# What `repair` and a hand-made rescue leave beside the live database. Same
# 28 MB as the real one, and the whole point of keeping them is that they are
# local safety copies.
*.bad
wowcraft.corrupt-*.sqlite3
wowcraft.sqlite3.rebuilt

# Where files go when device tooling cannot delete them.
_to_delete/
